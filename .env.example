# Copy to .env and fill in real values. NEVER commit the resulting .env.
# .env is listed in .gitignore.

APP_NAME=portal.manggaduasquare.co.id
APP_URL=http://localhost
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_DATABASE_MYSQL=
DB_USERNAME=
DB_PASSWORD=

# Session
SESSION_LIFETIME=120
SESSION_NAME=m2s_portal_session

# SMTP (mail delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENC=tls
MAIL_FROM=
MAIL_FROM_NAME=
